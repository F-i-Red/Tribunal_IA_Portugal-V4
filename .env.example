# ═══════════════════════════════════════════════════════════════════
#  Tribunal IA Portugal V5 — Configuração
#  Obtém chave gratuita em: https://openrouter.ai/keys
# ═══════════════════════════════════════════════════════════════════

# ── CHAVE API ────────────────────────────────────────────────────────
OPENROUTER_API_KEY=COLA AQUI A TUA API KEY

# ── BACKEND DE IA ────────────────────────────────────────────────────
# "openrouter"  → usa OpenRouter (cloud, default)
# "ollama"      → usa Ollama local (soberania de dados total, .gov recomendado)
BACKEND=openrouter

# ── MODELO OPENROUTER ────────────────────────────────────────────────
# GRATUITOS (testes / POC):
# MODELO=openrouter/free
# MODELO=meta-llama/llama-3.3-70b-instruct:free
# MODELO=deepseek/deepseek-r1:free
# MODELO=google/gemini-2.0-flash-exp:free

# PAGOS (produção .gov):
# MODELO=google/gemini-2.0-flash-001          # $0.10/1M — recomendado custo/qualidade
# MODELO=anthropic/claude-haiku-4-5           # $1.00/1M — rápido e preciso
# MODELO=anthropic/claude-sonnet-4.6          # $3.00/1M — qualidade máxima
# MODELO=openai/gpt-4.1-mini                  # $0.40/1M
MODELO=openrouter/free

# ── MODELO OLLAMA (se BACKEND=ollama) ───────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=llama3.3:70b
# Outros modelos Ollama recomendados:
# OLLAMA_MODELO=qwen2.5:72b
# OLLAMA_MODELO=deepseek-r1:32b
# OLLAMA_MODELO=mistral-nemo:12b

# ── RAG ──────────────────────────────────────────────────────────────
# "bm25"    → apenas BM25 (sem dependências extra)
# "hibrido" → BM25 + embeddings locais (requer sentence-transformers)
# "api"     → BM25 + embeddings via OpenRouter (sem deps extra locais)
RAG_MODO=bm25
# RAG_EMBEDDING_MODELO=intfloat/multilingual-e5-large  # se RAG_MODO=hibrido

# ── PARÂMETROS GERAIS ────────────────────────────────────────────────
MAX_RETRIES=5
REQUEST_TIMEOUT=180
LOG_LEVEL=INFO

# ── FUNCIONALIDADES ──────────────────────────────────────────────────
GUARDAR_ATAS=true
ANONIMIZAR_ENTIDADES=true
CACHE_ENABLED=true
PARALELISMO=false
MODO_ECONOMICO=true
HISTORICO_ENABLED=true
EXPORTAR_PDF=true
CONSISTENCIA_CHECK=true
