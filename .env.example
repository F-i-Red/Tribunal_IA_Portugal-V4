# Tribunal IA Portugal V7

# Backend
BACKEND=openrouter   # openrouter | ollama

# OpenRouter
OPENROUTER_API_KEY=COLA_AQUI_A_TUA_CHAVE
MODELO=openrouter/free
# Pagos recomendados: google/gemini-2.0-flash-001, anthropic/claude-sonnet-4.6

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=llama3.3:70b

# RAG V7
# bm25=sem downloads, hibrido=embeddings (requer sentence-transformers)
RAG_MODO=bm25
# Embeddings PT-específicos (escolhe um):
# Leve (118MB) — recomendado para primeiro arranque / Windows sem GPU:
RAG_EMBEDDING_MODELO=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Alta qualidade (560MB) — para produção:
# RAG_EMBEDDING_MODELO=intfloat/multilingual-e5-large-instruct
# PT-específico (440MB):
# RAG_EMBEDDING_MODELO=neuralmind/bert-base-portuguese-cased
# RAG_EMBEDDING_MODELO=neuralmind/bert-base-portuguese-cased
# RAG_EMBEDDING_MODELO=PORTULAN/serafim-pt-small-100m-lingua-pt
# RAG_EMBEDDING_MODELO=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Reranking (local cross-encoder ou Cohere API)
RAG_RERANKING=true
RAG_RERANKER_BACKEND=local          # local | cohere
RAG_RERANKER_MODELO=cross-encoder/ms-marco-MiniLM-L-6-v2
# RAG_RERANKER_MODELO=cross-encoder/mmarco-mMiniLMv2-L12-H384  # melhor para PT
COHERE_API_KEY=                     # só se RAG_RERANKER_BACKEND=cohere
RAG_TOP_K=15
RAG_TOP_N=6

# Orquestração
ORQUESTRACAO=langgraph

# Funcionalidades
GUARDAR_ATAS=true
ANONIMIZAR_ENTIDADES=true
CACHE_ENABLED=true
PARALELISMO=false
MODO_ECONOMICO=true
HISTORICO_ENABLED=true
EXPORTAR_PDF=true
CONSISTENCIA_CHECK=true
CONTRADITORIO_ENABLED=true
MULTILINGUE_ENABLED=true

# API REST — Produção
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=muda_isto_para_chave_segura_em_producao_min32chars
API_ACCESS_TOKEN_EXPIRE_MINUTES=60
API_RATE_LIMIT=30            # pedidos por minuto por IP
API_RATE_LIMIT_BURST=10      # burst adicional

# Observability
OBSERVABILITY_ENABLED=true
METRICS_PORT=9090            # Prometheus scrape port
OTEL_SERVICE_NAME=tribunal-ia-v7
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317  # Jaeger/Tempo

# Geral
MAX_RETRIES=5
REQUEST_TIMEOUT=180
LOG_LEVEL=INFO
