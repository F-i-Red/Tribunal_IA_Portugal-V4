# ═══════════════════════════════════════════════════════════════
#  Tribunal IA Portugal V6 — Configuração
# ═══════════════════════════════════════════════════════════════

# ── BACKEND ──────────────────────────────────────────────────
BACKEND=openrouter          # openrouter | ollama

# ── OPENROUTER ───────────────────────────────────────────────
OPENROUTER_API_KEY=COLA_AQUI_A_TUA_CHAVE
# Gratuitos (testes):
# MODELO=openrouter/free
# MODELO=meta-llama/llama-3.3-70b-instruct:free
# MODELO=deepseek/deepseek-r1:free
# Pagos (produção .gov — recomendado):
# MODELO=google/gemini-2.0-flash-001    # ⭐ melhor custo/qualidade
# MODELO=anthropic/claude-sonnet-4.6    # qualidade máxima
MODELO=openrouter/free

# ── OLLAMA (backend local — soberania de dados) ───────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=llama3.3:70b

# ── RAG V6 ───────────────────────────────────────────────────
# Modo: bm25 | hibrido | api
# hibrido = BM25 + sentence-transformers (RECOMENDADO em V6)
RAG_MODO=hibrido

# Modelo de embeddings — optimizado para Português e multilingual
# Opções recomendadas:
#   intfloat/multilingual-e5-large-instruct   (melhor qualidade, 560MB)
#   intfloat/multilingual-e5-base             (equilibrado, 280MB)
#   neuralmind/bert-base-portuguese-cased      (PT específico, 440MB)
#   sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2  (leve, 118MB)
RAG_EMBEDDING_MODELO=intfloat/multilingual-e5-large-instruct

# Reranking cross-encoder (melhora qualidade do RAG significativamente)
RAG_RERANKING=true
RAG_RERANKER_MODELO=cross-encoder/ms-marco-MiniLM-L-6-v2

# Número de resultados a recuperar antes do reranking
RAG_TOP_K=15
# Número final após reranking
RAG_TOP_N=6

# ── ORQUESTRAÇÃO ─────────────────────────────────────────────
# langgraph | imperativo (fallback V5)
ORQUESTRACAO=langgraph

# ── FUNCIONALIDADES ───────────────────────────────────────────
GUARDAR_ATAS=true
ANONIMIZAR_ENTIDADES=true
CACHE_ENABLED=true
PARALELISMO=false
MODO_ECONOMICO=true
HISTORICO_ENABLED=true
EXPORTAR_PDF=true
CONSISTENCIA_CHECK=true
CONTRADITORIO_ENABLED=true
MULTILINGUE_ENABLED=true

# ── API REST ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=muda_isto_em_producao_para_chave_segura

# ── GERAL ────────────────────────────────────────────────────
MAX_RETRIES=5
REQUEST_TIMEOUT=180
LOG_LEVEL=INFO
